{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md",
    "PROJECT_CONTEXT.md",
    ".opencode/instructions/*.md"
  ],
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.envrc": "deny",
      "*.env.example": "allow"
    },
    "bash": {
      "*": "ask",
      "printenv*": "deny",
      "env": "deny",
      "env *": "deny",
      "docker compose config*": "deny",
      "docker inspect*": "deny",
      "cat < *": "deny",
      "cat << *": "deny",
      "*.env": "deny",
      "*.envrc": "deny",
      "* .env": "deny",
      "* .envrc": "deny",
      "*/.env": "deny",
      "*/.envrc": "deny",
      "* .env*": "deny",
      "*/.env*": "deny",
      "* .envrc*": "deny",
      "*/.envrc*": "deny",
      "*.env.*": "deny",
      "* .env.*": "deny",
      "*/.env.*": "deny",
      "*.env.example": "allow",
      "* .env.example": "allow",
      "*/.env.example": "allow",
      "*.env.example *": "allow",
      "* .env.example *": "allow",
      "*/.env.example *": "allow"
    }
  },
  "agent": {
    "build": {
      "mode": "primary",
      "model": "opencode/big-pickle",
      "prompt": "You are a senior full-stack developer specializing in Python/FastAPI backends and React/TypeScript frontends. You implement features, fix bugs, and refactor code across the entire codebase. Always follow existing patterns, run tests before committing, and use conventional commits.",
      "permission": {
        "edit": "allow",
        "bash": {
          "*": "ask",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git branch*": "allow",
          "git checkout*": "allow",
          "git pull*": "allow",
          "git push*": "allow",
          "git add*": "allow",
          "git commit*": "allow",
          "gh issue*": "allow",
          "gh pr create*": "allow",
          "gh pr comment*": "allow",
          "gh pr edit*": "allow",
          "gh pr list*": "allow",
          "gh pr view*": "allow",
          "gh pr checks*": "allow",
          "gh label*": "allow",
          "gh pr merge*": "allow",
          "uv run*": "allow",
          "uv sync*": "allow",
          "make *": "allow",
          "docker compose ps*": "allow",
          "docker compose logs*": "allow",
          "printenv*": "deny",
          "env": "deny",
          "env *": "deny",
          "docker compose config*": "deny",
          "docker inspect*": "deny",
          "cat < *": "deny",
          "cat << *": "deny",
          "*.env": "deny",
          "*.envrc": "deny",
          "* .env": "deny",
          "* .envrc": "deny",
          "*/.env": "deny",
          "*/.envrc": "deny",
          "* .env*": "deny",
          "*/.env*": "deny",
          "* .envrc*": "deny",
          "*/.envrc*": "deny",
          "*.env.*": "deny",
          "* .env.*": "deny",
          "*/.env.*": "deny",
          "*.env.example": "allow",
          "* .env.example": "allow",
          "*/.env.example": "allow",
          "*.env.example *": "allow",
          "* .env.example *": "allow",
          "*/.env.example *": "allow"
        },
        "task": {
          "*": "deny",
          "explore": "allow",
          "reviewer": "allow",
          "visual": "allow",
          "plan": "allow"
        },
        "skill": {
          "*": "allow"
        }
      }
    },
    "plan": {
      "mode": "primary",
      "model": "opencode/nemotron-3-ultra-free",
      "prompt": "You are a software architect specializing in Python/FastAPI backends and Docker-based execution environments. Analyze requirements, explore the codebase, and create detailed implementation plans. Do not make any changes. Output: Goal, Files to modify, Dependencies, Risks, Steps.",
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "deny",
          "git log*": "allow",
          "git diff*": "allow",
          "ls*": "allow"
        },
        "task": {
          "*": "deny",
          "explore": "allow",
          "reviewer": "allow",
          "visual": "allow"
        },
        "skill": {
          "*": "allow"
        }
      }
    },
    "backend": {
      "description": "Implements FastAPI routes, services, Celery workers, and evaluation logic",
      "mode": "subagent",
      "permission": {
        "edit": {
          "backend/**": "allow",
          "*.py": "allow",
          "migrations/**": "allow"
        },
        "bash": {
          "*": "ask",
          "cd backend*": "allow",
          "uv run*": "allow",
          "uv sync*": "allow",
          "python*": "allow",
          "printenv*": "deny",
          "env": "deny",
          "env *": "deny",
          "docker compose config*": "deny",
          "docker inspect*": "deny",
          "cat < *": "deny",
          "cat << *": "deny",
          "*.env": "deny",
          "*.envrc": "deny",
          "* .env": "deny",
          "* .envrc": "deny",
          "*/.env": "deny",
          "*/.envrc": "deny",
          "* .env*": "deny",
          "*/.env*": "deny",
          "* .envrc*": "deny",
          "*/.envrc*": "deny",
          "*.env.*": "deny",
          "* .env.*": "deny",
          "*/.env.*": "deny",
          "*.env.example": "allow",
          "* .env.example": "allow",
          "*/.env.example": "allow",
          "*.env.example *": "allow",
          "* .env.example *": "allow",
          "*/.env.example *": "allow"
        }
      }
    },
    "frontend": {
      "description": "Implements React UI components, pages, hooks, and client-side behavior",
      "mode": "subagent",
      "permission": {
        "edit": {
          "frontend/**": "allow",
          "*.tsx": "allow",
          "*.ts": "allow"
        },
        "bash": {
          "*": "ask",
          "cd frontend*": "allow",
          "npm*": "allow",
          "npx*": "allow",
          "printenv*": "deny",
          "env": "deny",
          "env *": "deny",
          "docker compose config*": "deny",
          "docker inspect*": "deny",
          "cat < *": "deny",
          "cat << *": "deny",
          "*.env": "deny",
          "*.envrc": "deny",
          "* .env": "deny",
          "* .envrc": "deny",
          "*/.env": "deny",
          "*/.envrc": "deny",
          "* .env*": "deny",
          "*/.env*": "deny",
          "* .envrc*": "deny",
          "*/.envrc*": "deny",
          "*.env.*": "deny",
          "* .env.*": "deny",
          "*/.env.*": "deny",
          "*.env.example": "allow",
          "* .env.example": "allow",
          "*/.env.example": "allow",
          "*.env.example *": "allow",
          "* .env.example *": "allow",
          "*/.env.example *": "allow"
        }
      }
    },
    "reviewer": {
      "description": "Reviews code for bugs, security issues, and regressions without editing",
      "mode": "subagent",
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "deny",
          "git diff*": "allow",
          "git log*": "allow",
          "grep *": "allow"
        },
        "skill": {
          "*": "allow"
        }
      }
    },
    "visual": {
      "description": "Visual QA: inspects screenshots, contact sheets, and video frames (multimodal; reports findings as text)",
      "mode": "all",
      "color": "warning",
      "model": "opencode/mimo-v2.6-flash-free",
      "prompt": "You are a visual QA agent for the AI Code Evaluation Platform. You inspect images the build agent cannot see (screenshots, contact sheets, video frames, render outputs) and report your observations as precise text using the Read tool on image files (PNG/JPEG/WebP/GIF). Describe: layout and alignment, spacing and rhythm, typography and hierarchy, color/contrast issues, clipping and overflow, broken/missing assets, and anything that looks off. Prefer specific, comparable observations (relative sizes, positions, which region of the frame) over vague impressions. For videos or animated GIFs, call out the frames you sampled; for long videos recommend extracting a contact sheet first. You never edit files — you return findings to the requesting agent or user.",
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "deny",
          "ls*": "allow"
        },
        "task": {
          "*": "deny"
        },
        "skill": {
          "*": "deny"
        }
      }
    }
  }
}
