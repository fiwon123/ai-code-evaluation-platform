# Backend *settings* go in backend/.env, which pydantic-settings reads for the
# ENVIRONMENT/DATABASE_URL/... fields below. The defaults in app/config.py
# already match a local dev setup, so this file is optional.
#
# Provider API keys do NOT belong here. docker-compose.yml interpolates
# ${GROQ_API_KEY:-} / ${GEMINI_API_KEY:-} on the host, so they must be in the
# repo-root .env (next to docker-compose.yml) or the worker never sees them —
# app/services/llm.py reads them with os.getenv, which pydantic-settings does
# not populate from this file. Restart the stack afterwards: `make dev-restart`.
# Never commit either file.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://postgres:mysecretpassword@localhost:5432/postgres
REDIS_URL=redis://localhost:6379
JWT_SECRET_KEY=dev-secret-key-change-in-production
LLM_PROVIDER=demo
DOCKER_ENABLED=true
DOCKER_IMAGE=eval-sandbox:latest

# Auto-repair: total generate-and-test attempts per submission. A failing
# attempt is fed back to the LLM and re-tested. Set to 1 to disable the loop.
EVALUATION_MAX_ATTEMPTS=3
# Characters of raw test output appended to a repair prompt (log tail).
REPAIR_LOG_TAIL_CHARS=4000

# Local Ollama. A local model runs on this machine's CPU, so generation can take
# minutes for a small code model on a weak host — the default 300s is generous on
# purpose. Lower it to fail fast against a dead server, raise it for a larger
# local model (a 7B wants considerably more). Only the provider's HTTP call is
# affected: test execution keeps its own EVALUATION_TIMEOUT budget.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT=300