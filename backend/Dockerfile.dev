# syntax=docker/dockerfile:1

# Dev image for the FastAPI backend — hot reload via a bind-mounted source
# directory and uvicorn --reload. No compiled overlays needed.
#
# Run: docker compose run --service-ports backend-dev
#
# The devcontainer also mounts the workspace, so keep the image as close to
# the devcontainer base as possible (python:3.14-slim + uv).

FROM python:3.14-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

# --mount=type=bind requires BuildKit; fall back to COPY otherwise.
# hadolint ignore=DL3013
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --no-cache-dir uv

# NOTE: newest uv is intentional to match the lockfile produced by the devcontainer toolchain.

WORKDIR /workspace/backend

# Keep the container alive; uvicorn is started with --reload by the
# compose/dev-container orchestration so source changes hot-reload.
CMD ["sleep", "infinity"]